# CyberShield Security Monitor - Environment Variables Template
# Copy this to .env.local and fill in your Supabase credentials

# Supabase Config
VITE_SUPABASE_URL=https://pfrfeebtiktnfgdeoqvl.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Security Monitor Function URL
VITE_SECURITY_MONITOR_URL=https://pfrfeebtiktnfgdeoqvl.supabase.co/functions/v1/security-monitor

# AI Threat Detection (HuggingFace)
# Get your free API key from: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Enable AI Features
VITE_ENABLE_AI_THREAT_DETECTION=true
VITE_AI_ANALYSIS_MODE=hybrid

# How to get these values:
# 1. Go to https://app.supabase.com
# 2. Select your project (AI_Cybersecurity_Detector)
# 3. Settings → API
# 4. Copy the "anon" key and paste it above
# 5. Your project URL should match VITE_SUPABASE_URL
# 6. For HuggingFace: Go to https://huggingface.co/settings/tokens and create an API token
